// Prisma schema: https://pris.ly/d/prisma-schema
//
// Workflow:
//   1. Add or change models below.
//   2. Run `npm run prisma:migrate -- --name <change>` to migrate the dev
//      database and regenerate the client.
//   3. Inject `PrismaService` wherever you need database access.
//
// The SQLite file lives at prisma/dev.db (see DATABASE_URL in .env); the path
// is resolved relative to this directory.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Example:
//
// model Device {
//   id        String   @id @default(cuid())
//   name      String
//   createdAt DateTime @default(now())
// }

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("USER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
}
