// Prisma schema: https://pris.ly/d/prisma-schema
//
// Workflow:
//   1. Add or change models below.
//   2. Run `npm run prisma:migrate -- --name <change>` to migrate the dev
//      database and regenerate the client.
//   3. Inject `PrismaService` wherever you need database access.
//
// The database is PostgreSQL. Set DATABASE_URL in .env (see .env.example) to a
// `postgresql://` connection string; migrations live in prisma/migrations.
// Older SQLite migrations are kept in prisma/migrations-sqlite for reference.
//
// Every entity carries audit columns: `createdAt` and `updatedAt` are managed
// automatically, while `createdBy` and `updatedBy` hold the id of the user that
// performed the change. They are filled from the optional `x-actor-id` request
// header (see `@ActorId()` and `CrudService`) and are intentionally not foreign
// keys, so audit rows survive user deletion.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A listing is either an offer to buy or an offer to sell.
enum Orientation {
  buy
  sell
}

/// A country a listing belongs to. `id = 0` is the "All regions" row used when
/// the visitor's country cannot be detected or no region filter is wanted.
model Region {
  id            Int @id @default(autoincrement())
  /// ISO 3166-1 alpha-2 code; `ALL` for the global row.
  code          String @unique
  descriptionId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  listings Listing[]

  @@index([descriptionId])
}

/// A language the interface and description texts are available in.
model Language {
  code String @id
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  descriptions Description[]
  listingTranslations ListingTranslation[]
}

// Example:
//
// model Device {
//   id        String   @id @default(cuid())
//   name      String
//   createdAt DateTime @default(now())
// }

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  /// `null` for accounts created through a social provider (they sign in there).
  passwordHash String?
  role         String   @default("USER")
  isActive     Boolean  @default(true)
  /// When the user accepted the terms of service at signup.
  acceptedTermsAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  oauthAccounts OAuthAccount[]

  @@index([name])
}

/// A social identity linked to an account. `providerAccountId` is the provider's
/// stable user id (Google's `sub`), never the email, which can change.
model OAuthAccount {
  id                Int      @id @default(autoincrement())
  userId            Int
  /// `google` (more providers can follow).
  provider          String
  providerAccountId String
  /// Email as returned by the provider when the link was created.
  email             String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([provider, userId])
  @@index([email])
  @@index([userId])
}

/// A signed-in browser session. `id` is the SHA-256 of the cookie token, so a
/// leaked database row cannot be replayed as a cookie.
model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A listing filed under a category.
model Listing {
  id          Int         @id @default(autoincrement())
  categoryId  Int
  /// Region the listing is published in; 0 means "no specific region".
  regionId    Int         @default(0)
  orientation Orientation
  userId      Int
  isActive    Boolean     @default(true)
  price       Float?
  year        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  category             Category              @relation(fields: [categoryId], references: [id])
  region               Region                @relation(fields: [regionId], references: [id])
  facetValueSelections FacetValueSelection[]
  chatThreads          ListingChatThread[]
  images               ListingImage[]
  translations         ListingTranslation[]
  events               ListingEvent[]

  @@index([categoryId])
  @@index([regionId])
  @@index([userId])
}

/// What happened on a listing page. `view` is recorded by the beacon on the
/// listing page; `contact` and `share` are reserved for later surfaces.
enum ListingEventType {
  view
  contact
  share
}

/// One counted interaction with a listing, deduplicated per visitor and day by
/// the unique index (a refresh does not inflate the number). `visitorId` is a
/// random cookie value, never an IP or a session token.
model ListingEvent {
  id        Int              @id @default(autoincrement())
  listingId Int
  type      ListingEventType @default(view)
  visitorId String
  /// UTC day bucket: one row per visitor, type and listing per day.
  day       DateTime         @db.Date
  /// Where the visit started (`search`, `direct`, ...), bounded by the DTO.
  source    String?
  language  String?

  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, type, visitorId, day])
  @@index([listingId, day])
  @@index([day])
}

/// Why a seller removed a listing. Deliberately has no foreign keys: the row is
/// recorded just before the listing is deleted and survives it, so the answers
/// can be reported later. The allowed values depend on the listing orientation:
/// `sold`/`sale_fell_through`/`kept`/`gave_away` for "sell", and
/// `purchased`/`purchase_fell_through`/`no_longer_needed`/`bought_elsewhere`
/// for "buy".
enum ListingOutcomeType {
  sold
  sale_fell_through
  kept
  gave_away
  purchased
  purchase_fell_through
  no_longer_needed
  bought_elsewhere
}

model ListingOutcome {
  id         Int                @id @default(autoincrement())
  listingId  Int
  userId     Int
  categoryId Int
  outcome    ListingOutcomeType
  /// Final price for `sold`/`purchased`; null for the other outcomes or when
  /// left blank.
  finalPrice Float?
  createdAt  DateTime           @default(now())

  @@index([userId])
  @@index([categoryId])
  @@index([outcome])
}

/// A listing's title in one language. A draft is created with the UI language's
/// title; other languages are added through the translate dialog. Missing
/// translations fall back to another language (and finally the generated
/// "Category #id" label).
model ListingTranslation {
  listingId Int
  language  String
  title     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  languageRef Language @relation(fields: [language], references: [code])

  @@id([listingId, language])
  @@index([language])
}

/// A node in the category tree. `parentCategoryId` is null for root categories.
model Category {
  id               Int  @id @default(autoincrement())
  descriptionId    Int
  parentCategoryId Int?
  /// Inline SVG markup for the category icon (`<svg viewBox="…">…</svg>`),
  /// written through `PATCH /categories/:id` only. The API sanitizes it against
  /// a strict allow-list before storing (see `category-icon.ts`), and the
  /// clients render it inline. `null` falls back to the title-based icon.
  iconSvg          String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  parentCategory  Category?     @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  childCategories Category[]    @relation("CategoryTree")
  listings        Listing[]
  facetSchemas    FacetSchema[]

  @@index([descriptionId])
  @@index([parentCategoryId])
}

/// A translated piece of text, shared by categories and facets. Every `id`
/// groups one translation per language (the primary key is `[id, language]`),
/// so a description always has a text in every configured language.
model Description {
  id       Int
  language String
  /// i18n key for interface strings (`common.close`); null for category/facet
  /// descriptions. The same key is stored on every language row of the group.
  name     String?
  text     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  languageRef Language @relation(fields: [language], references: [code])

  @@id([id, language])
  @@unique([name, language])
  @@index([language])
}

/// A message inside a chat thread. `userId` is the id of the user which created it.
model ChatMessage {
  id       Int    @id @default(autoincrement())
  text     String
  threadId Int
  userId   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

/// A conversation.
model ChatThread {
  id Int @id @default(autoincrement())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  messages    ChatMessage[]
  listingLink ListingChatThread?
  inboxItem   InboxItem?
}

/// Attaches a chat thread to the listing it is about.
model ListingChatThread {
  id           Int @id @default(autoincrement())
  listingId    Int
  chatThreadId Int @unique
  hasUnread    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  listing    Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  chatThread ChatThread @relation(fields: [chatThreadId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

/// A chat thread shown in a user's inbox.
model InboxItem {
  id           Int @id @default(autoincrement())
  userId       Int
  chatThreadId Int @unique
  hasUnread    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  chatThread ChatThread @relation(fields: [chatThreadId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// An image attached to a listing. The compressed bytes live in
/// `ListingImageData` (PostgreSQL) so they survive redeploys; `fileName` is the
/// generated logical name and the original upload name is intentionally not kept.
model ListingImage {
  id           Int     @id @default(autoincrement())
  listingId    Int
  fileName     String  @unique
  mimeType     String
  size         Int
  primaryImage Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  listing Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  data    ListingImageData?

  @@index([listingId])
}

/// The binary content of a listing image. Kept in a separate table so listing
/// and metadata queries never load the bytes.
model ListingImageData {
  listingImageId Int      @id
  bytes          Bytes
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  listingImage ListingImage @relation(fields: [listingImageId], references: [id], onDelete: Cascade)
}

/// How a facet question is answered: a selectable option or a numeric value.
enum FacetType {
  numeric
  option
}

/// A facet (filterable attribute) that belongs to a category. `isGeneric`
/// facets apply to products in every category (for example condition).
/// `required` facets have to be answered before a listing can be published.
model FacetSchema {
  id            Int       @id @default(autoincrement())
  descriptionId Int
  name          String    @unique
  categoryId    Int
  isGeneric     Boolean   @default(false)
  type          FacetType @default(option)
  required      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  category    Category           @relation(fields: [categoryId], references: [id])
  options     FacetValueOption[]

  @@index([descriptionId])
  @@index([categoryId])
}

/// One selectable value of a facet.
model FacetValueOption {
  id            Int @id @default(autoincrement())
  descriptionId Int
  schemaId      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  schema      FacetSchema           @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  selections  FacetValueSelection[]

  @@index([descriptionId])
  @@index([schemaId])
}

/// Links a listing to the facet values selected for it.
model FacetValueSelection {
  id                 Int @id @default(autoincrement())
  facetValueOptionId Int
  listingId          Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  facetValueOption FacetValueOption @relation(fields: [facetValueOptionId], references: [id], onDelete: Cascade)
  listing          Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([facetValueOptionId])
  @@index([listingId])
}
