# Copy to .env and adjust as needed.
# PostgreSQL connection string. URL-encode special characters in the password
# (for example "!" becomes "%21"). On Render, set this to the Internal Database
# URL of the Postgres instance.
DATABASE_URL="postgresql://postgres:password@localhost:5432/kiosk?schema=public"

# Comma-separated browser origins allowed to call the API (CORS). Leave unset
# to use the defaults in src/main.ts (local Vite + the deployed frontend).
# FRONTEND_ORIGINS=https://kiosk-9j6p.onrender.com

# Session cookie. Cross-origin frontends need SameSite=None (the default in
# production); a same-origin proxy/BFF can use Lax. TTL is in days.
# SESSION_COOKIE_NAME=kiosk_session
# SESSION_TTL_DAYS=7
# SESSION_COOKIE_SAMESITE=none

# Anonymous visitor id used to dedupe listing views (one row per visitor/day).
# VISITOR_COOKIE_NAME=kiosk_visitor

# Signup notifications: POST { text, content } to this URL (Slack, Discord, or any
# endpoint). Leave unset to disable. PUBLIC_ORIGIN is added to the message.
# SIGNUP_WEBHOOK_URL=https://hooks.slack.com/services/...
# PUBLIC_ORIGIN=https://kiosk-ssr.onrender.com

# Owner account: on boot, this email is promoted to ADMIN (or created when a
# password is given). Signup always creates USER rows.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Owner

# Google sign-in (OAuth 2.0 / OpenID Connect). Create a "Web application" OAuth
# client and register <api>/auth/google/callback as an authorized redirect URI.
# Without these two values the Google button answers "not available".
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxx
# GOOGLE_REDIRECT_URI=https://kiosk-api-znxy.onrender.com/auth/google/callback
