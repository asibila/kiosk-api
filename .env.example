# Copy to .env and adjust as needed.
# PostgreSQL connection string. URL-encode special characters in the password
# (for example "!" becomes "%21"). On Render, set this to the Internal Database
# URL of the Postgres instance.
DATABASE_URL="postgresql://postgres:password@localhost:5432/kiosk?schema=public"

# Comma-separated browser origins allowed to call the API (CORS). Leave unset
# to use the defaults in src/main.ts (local Vite + the deployed frontend).
# FRONTEND_ORIGINS=https://kiosk-9j6p.onrender.com
